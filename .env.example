# =====================================================================
# Agentic Pilot — Environment Configuration Template
# Copy this file to `.env` to customize settings for your local machine.
# =====================================================================

# ---------------------------------------------------------------------
# Local LLM Runtime (Ollama)
# ---------------------------------------------------------------------
PILOT_OLLAMA_BASE_URL=http://127.0.0.1:11434
PILOT_OLLAMA_MODEL=qwen2.5:1.5b
PILOT_OLLAMA_VISION_MODEL=moondream

# ---------------------------------------------------------------------
# Multi-Model Dynamic Routing Candidates
# ---------------------------------------------------------------------
# Routing strategies: "dynamic", "static", "single"
PILOT_MODEL_ROUTING_STRATEGY=dynamic
PILOT_MODEL_REASONING=qwen2.5:7b
PILOT_MODEL_VISION=moondream
PILOT_MODEL_CODING=qwen2.5-coder:3b
PILOT_MODEL_LIGHTWEIGHT=deepseek-r1:1.5b
PILOT_MODEL_FALLBACK=qwen2.5:1.5b
PILOT_MODEL_SWITCH_COOLDOWN_STEPS=1
PILOT_TASK_CONTEXT_TOKEN_BUDGET=3500

# ---------------------------------------------------------------------
# Server & Network Ports
# ---------------------------------------------------------------------
PILOT_SERVER_PORT=8765
PILOT_DEBUG_MODE=false

# ---------------------------------------------------------------------
# Browser Automation (Playwright)
# ---------------------------------------------------------------------
# Set to true for headless execution, false to watch execution visually
PILOT_HEADLESS_BROWSER=false
PILOT_BROWSER_POOL_SIZE=3
PILOT_KEEP_BROWSER_OPEN=true
PILOT_BROWSER_IDLE_TIMEOUT_MINUTES=15

# ---------------------------------------------------------------------
# Execution & Safety
# ---------------------------------------------------------------------
PILOT_AUTO_APPROVE_LOW_RISK=true
PILOT_APPROVAL_TIMEOUT_SECONDS=10
PILOT_MAX_RETRY_COUNT=3
PILOT_MAX_TASK_DURATION_MINUTES=5
PILOT_SESSION_TTL_HOURS=24

# ---------------------------------------------------------------------
# Feature Flags (Research & Ablation Controls)
# ---------------------------------------------------------------------
PILOT_ENABLE_EVIDENCE=true
PILOT_ENABLE_VERIFICATION=true
PILOT_ENABLE_RECOVERY=true
PILOT_ENABLE_MEMORY=true
PILOT_ENABLE_RAG=true
PILOT_ENABLE_MULTI_MODEL=true

# ---------------------------------------------------------------------
# Retrieval-Augmented Generation (RAG) & Memory
# ---------------------------------------------------------------------
PILOT_RAG_KNOWLEDGE_COLLECTION=pilot_knowledge
PILOT_RAG_TOP_K=5
PILOT_RAG_SIMILARITY_THRESHOLD=0.45
PILOT_RAG_MAX_CONTEXT_TOKENS=2000
PILOT_RAG_CACHE_ENABLED=true
PILOT_RAG_CACHE_TTL_SECONDS=3600
PILOT_RAG_KNOWLEDGE_DIR=~/.pilot/knowledge
PILOT_RAG_EMBEDDING_MODEL=all-minilm

# ---------------------------------------------------------------------
# Persistence & Privacy Auditing
# ---------------------------------------------------------------------
PILOT_DB_PATH=~/.pilot/data.db
PILOT_DATA_DIR=~/.pilot/data
PILOT_LOG_DIR=~/.pilot/logs
PILOT_PRIVACY_AUDIT_ENABLED=true
PILOT_PRIVACY_AUDIT_LOG=~/.pilot/logs/privacy_audit.jsonl
PILOT_EXPERIMENT_MODE=false
PILOT_EXPERIMENT_OUTPUT_DIR=~/.pilot/experiments
